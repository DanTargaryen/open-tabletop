{
  "name": "open-tabletop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source browser games including poker, collection, deduction, racing, survival and 2D artillery games, with local AI and multiplayer rooms.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "lan": "node server/index.mjs --host 0.0.0.0",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/check-browser-playability.mjs",
    "test:e2e:steel": "node scripts/check-steel-friend-room.mjs",
    "test:audio:steel": "node scripts/check-steel-audio.mjs",
    "build:static": "node scripts/build-static.mjs",
    "measure:poker-sync": "node games/texas-holdem/scripts/measure-sync.mjs",
    "test:e2e:chamber": "node scripts/check-chamber-compensation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DanTargaryen/open-tabletop.git"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
