{
  "name": "open-tabletop",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../../.dist/public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health"]},
  "d1_databases": [
    {"binding": "DB", "database_name": "open-tabletop-poker", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID", "migrations_dir": "./migrations"}
  ]
}
